"VertexLitGeneric"
{
    "$basetexture" "props/ut2004/sigma/ut2_PC_ConvoyStatics__Deco1__PC_sg_Mech_cyl2__PC_ConvoyStatics__StaticMesh__PC_sg_Mech_cyl2_m00"
    //"$surfaceprop" "metal"
    "$model" "1"

    // 1. Tints white/grayscale arrows to bright red (RGB values from 0.0 to 1.0)
    "$color" "[1.0 0.0 0.0]"

    // 2. Makes the sign glow in the dark (common for UT2004 neon/chevron signs)
    "$selfillum" "1"

    // 3. Keeps transparency (If the background turns solid black, swap "$alphatest" "1" for "$additive" "1")
    "$alphatest" "1"

    // 4. REQUIRED for TextureScroll to work
    "$basetexturetransform" "center .5 .5 scale 1 1 rotate 0 translate 0 0"

    "Proxies"
    {
        "TextureScroll"
        {
            "texturescrollvar" "$basetexturetransform"
            "texturescrollrate" "1.0"
            "texturescrollangle" "0"
        }
    }
}
